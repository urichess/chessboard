/ {
	chosen {
		zephyr,console = &usart3;
		zephyr,shell-uart = &usart3;
		uart-sender = &usart1;
		config-data = &storage_partition;
	};

    zephyr,user {
            /* adjust channel number according to pinmux in board.dts */
            /*               A0-PA0      A1-PA1    A2-PA4         A3-PB0       A4-PC1      A5-PC0*/
            //io-channels = <&adc1 1>, <&adc1 2>, <&adc2 17>,  <&adc1 15>,   <&adc12 7>, <&adc12 6> ;
            io-channels = <&adc1 1>, <&adc1 2>, <&adc2 17>,  <&adc1 15> ;
            //io-channels = <&adc1 1>, <&adc1 2>;
	mux-gpios =  <&arduino_header 9 0>, // D3
	             <&arduino_header 10 0>, // D4
	             <&arduino_header 11 0>, // D5
	             <&arduino_header 12 0>; // D6
	enable-gpios =  <&arduino_header 8 0>; // D2

    };
};

&usart3 {
	pinctrl-0 = <&usart3_tx_pc10 &usart3_rx_pc11>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&adc1 {
    pinctrl-0 = <&adc1_in1_pa0 &adc1_in2_pa1 &adc1_in15_pb0>;  // add whatever inputs you need
    pinctrl-names = "default";
    st,adc-clock-source = "SYNC";
    st,adc-prescaler = <4>;

    vref-mv = <3300>;
    status = "okay";

     #address-cells = <1>;
    #size-cells = <0>;

    channel@1 {
        reg = <1>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };

    channel@2 {
        reg = <2>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };

    channel@15 {
        reg = <15>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };

};



&adc2 {
    //pinctrl-0 = <&adc2_in6_pc1 &adc2_in7_pc0 &adc2_in17_pa4>;  // add whatever inputs you need
    pinctrl-0 = <&adc2_in17_pa4>;  // add whatever inputs you need
    pinctrl-names = "default";
    st,adc-clock-source = "SYNC";
    st,adc-prescaler = <4>;

    vref-mv = <3300>;
    status = "okay";

    #address-cells = <1>;
    #size-cells = <0>;
 
    channel@17 {
        reg = <17>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };

};


