//&flash0 {
//	partitions {
//		compatible = "fixed-partitions";
//		#address-cells = <1>;
//		#size-cells = <1>;

//		/*
//		 * Reserve the final 16 KiB for file system partition
//		 */
//		storage_partition: partition@3c000 {
//			label = "storage";
//			reg = <0x0003c000 DT_SIZE_K(16)>;
//		};
//	};
//};

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        /* MCUboot bootloader: 36 KB */
        boot_partition: partition@0 {
            label = "mcuboot";
            reg = <0x00000000 DT_SIZE_K(36)>;
        };

        /* Primary image slot: 98 KB */
        slot0_partition: partition@9000 {
            label = "image-0";
            reg = <0x00009000 DT_SIZE_K(98)>;
        };

        /* Secondary image slot: 98 KB */
        slot1_partition: partition@11D00 {
            label = "image-1";
            reg = <0x00011D00 DT_SIZE_K(98)>;
        };

        /* Scratch: 8 KB */
        scratch_partition: partition@3A000 {
            label = "image-scratch";
            reg = <0x0003A000 DT_SIZE_K(8)>;
        };

        /* Storage / NVS: 16 KB at end of flash */
        storage_partition: partition@3C000 {
            label = "storage";
            reg = <0x0003C000 DT_SIZE_K(16)>;
        };
    };
};


&adc1 {
    pinctrl-0 = <&adc1_in6_pa1 &adc1_in7_pa2 &adc1_in8_pa3 &adc1_in9_pa4>;  // add whatever inputs you need
    pinctrl-names = "default";
    st,adc-clock-source = "SYNC";
    st,adc-prescaler = <4>;

    vref-mv = <3300>;
    status = "okay";

     #address-cells = <1>;
    #size-cells = <0>;

    channel@6 {
        reg = <6>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };

    channel@7 {
        reg = <7>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };

    channel@8 {
        reg = <8>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };

    channel@9 {
        reg = <9>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };

};

