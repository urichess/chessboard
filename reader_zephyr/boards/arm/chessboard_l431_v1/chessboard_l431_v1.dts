/dts-v1/;
#include <st/l4/stm32l431Xc.dtsi>
#include <st/l4/stm32l431c(b-c)tx-pinctrl.dtsi>

/ {
	model = "Custom STM32L431CCT6 board";
	compatible = "st,stm32l431";

	chosen {
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		//zephyr,canbus = &can1;
                uart-sender = &usart3;
                config-data = &storage_partition;
		zephyr,code-partition = &slot0_partition;
	};

	leds: leds {
		compatible = "gpio-leds";

		red_led: led_0 {
			gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>;
			label = "Alive LED";
		};

		orange_led: led_1 {
			gpios = <&gpioa 7 GPIO_ACTIVE_HIGH>;
			label = "USER LED";
		};

		green_led: led_2 {
			gpios = <&gpioa 6 GPIO_ACTIVE_HIGH>;
			label = "User2 LED";
		};

	};

	aliases {
		led0 = &red_led;
		led1 = &orange_led;
	};


        zephyr,user {
            //               A0-PA0      A1-PA1    A2-PA4         A3-PB0       A4-PC1      A5-PC0
            io-channels = <&adc1 6>, <&adc1 7>, <&adc1 8>,  <&adc1 9> ;
            //io-channels = <&adc1 1>, <&adc1 2>;
	    mux-gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>,
	    	        <&gpioh 1 GPIO_ACTIVE_HIGH>,
	    	        <&gpioh 0 GPIO_ACTIVE_HIGH>,
	    	        <&gpioc 13 GPIO_ACTIVE_HIGH>;

            enable-gpios =  <&gpiob 2 GPIO_ACTIVE_LOW>;
	};

};



/* Keep HSI enabled for system clock. This is 16Mhz */
&clk_hsi {
        status = "okay";
};

&clk_hse {
        status = "disabled";   /* no MHz external crystal */
};

/* Enable LSE for RTC/time base */
&clk_lse {
        status = "okay";
};


&clk_msi {
        status = "disabled";
};

/* Optional: keep LSI even LSE is enabled if you want dual RTC sources/watchdog */
&clk_lsi {
        status = "okay";
};

/* Configure PLL from HSI (16 MHz → 80 MHz) */
&pll {
        div-m = <1>;              /* /1  */
        mul-n = <20>;             /* ×20 */
        div-r = <4>;              /* /4  → 80 MHz */
        clocks = <&clk_hsi>;
        status = "okay";
};

/* Use PLL output as system clock */
&rcc {
        clocks = <&pll>;
        clock-frequency = <DT_FREQ_M(80)>;
        ahb-prescaler  = <1>;
        apb1-prescaler = <1>;
        apb2-prescaler = <1>;
};

&usart1 {
	pinctrl-0 = <&usart1_tx_pb6 &usart1_rx_pb7>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&usart3 {
	pinctrl-0 = <&usart3_tx_pb10 &usart3_rx_pb11>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};


