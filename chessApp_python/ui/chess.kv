#:kivy 1.0.9

<MenuScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 15

        Label:
            text: "Lichess Game Setup"
            font_size: '24sp'
            size_hint_y: 0.2

        TextInput:
            id: token_input
            hint_text: "Enter Lichess Token"
            multiline: False
            size_hint_y: 0.2

        TextInput:
            id: serial_input
            hint_text: "Enter Serial Port (e.g., COM3 or /dev/ttyUSB0)"
            multiline: False
            size_hint_y: 0.2

        Button:
            text: "Start Game"
            size_hint_y: 0.2
            background_color: 0.1, 0.6, 0.3, 1
            on_press:
                root.start_game()

