#:kivy 1.0.9

<MenuScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 15

        Label:
            text: "Lichess Game Setup"
            font_size: '24sp'
            size_hint_y: 0.2

        TextInput:
            id: token_input
            hint_text: "Enter Lichess Token"
            multiline: False
            size_hint_y: 0.2

        TextInput:
            id: serial_input
            hint_text: "Enter Serial Port (e.g., COM3 or /dev/ttyUSB0)"
            multiline: False
            size_hint_y: 0.2

        Button:
            text: "Start Game"
            size_hint_y: 0.2
            background_color: 0.1, 0.6, 0.3, 1
            on_press:
                root.start_game()

<ChessGameScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 15

        # Top bar for game info
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: 0.1
            spacing: 10
            Label:
                text: "Game ID: {}".format(root.game_id if hasattr(root, 'game_id') else 'N/A')
                font_size: '18sp'
                color: (0.7, 0.7, 0.7, 1)
            Label:
                text: "Status: {}".format(root.game_status if hasattr(root, 'game_status') else 'In Progress')
                font_size: '18sp'
                color: (0.7, 0.7, 0.7, 1)
                halign: 'right'

        # Player sections
        BoxLayout:
            orientation: 'horizontal'
            spacing: 15

            # White player section
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.48
                spacing: 8
                padding: 10
                canvas.before:
                    Color:
                        rgba: (0.85, 0.85, 0.85, 1) if root.active_player == 'white' else (0.65, 0.65, 0.65, 1)
                    Rectangle:
                        pos: self.pos
                        size: self.size
                    Color:
                        rgba: (1, 1, 1, 0.2) if root.active_player == 'white' else (0, 0, 0, 0)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [15]

                Label:
                    text: "{} ({} Elo)".format(root.white_name, root.white_rating if hasattr(root, 'white_rating') else '?')
                    font_size: '22sp'
                    bold: True
                    color: (0.1, 0.1, 0.1, 1) if root.active_player == 'white' else (0.4, 0.4, 0.4, 1)
                    size_hint_y: 0.2

                Label:
                    id: white_time
                    text: root.white_time if hasattr(root, 'white_time') else '05:00'
                    font_size: '36sp'
                    color: (0.1,0.1,0.1,1) if root.active_player == 'white' else (0.4,0.4,0.4,1)
                    size_hint_y: 0.35

                Label:
                    id: white_last_move
                    text: '{}'.format(root.white_last_move if hasattr(root, 'white_last_move') else '-')
                    font_size: '20sp'
                    italic: True
                    color: (0.2, 0.2, 0.2, 1) if root.active_player == 'white' else (0.5,0.5,0.5,1)
                    size_hint_y: 0.2

            # Divider
            Widget:
                size_hint_x: 0.04

            # Black player section
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.48
                spacing: 8
                padding: 10
                canvas.before:
                    Color:
                        rgba: (0.35, 0.35, 0.35, 1) if root.active_player == 'black' else (0.25, 0.25, 0.25, 1)
                    Rectangle:
                        pos: self.pos
                        size: self.size
                    Color:
                        rgba: (1, 1, 1, 0.2) if root.active_player == 'black' else (0, 0, 0, 0)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [15]

                Label:
                    text: "{} ({} Elo)".format(root.black_name, root.black_rating if hasattr(root, 'black_rating') else '?')
                    font_size: '22sp'
                    bold: True
                    color: (1, 1, 1, 1) if root.active_player == 'black' else (0.7, 0.7, 0.7, 1)
                    size_hint_y: 0.2

                Label:
                    id: black_time
                    text: root.black_time if hasattr(root, 'black_time') else '05:00'
                    font_size: '36sp'
                    color: (1,1,1,1) if root.active_player == 'black' else (0.7,0.7,0.7,1)
                    size_hint_y: 0.35

                Label:
                    id: black_last_move
                    text: '{}'.format(root.black_last_move if hasattr(root, 'black_last_move') else '-')
                    font_size: '20sp'
                    italic: True
                    color: (1, 1, 1, 1) if root.active_player == 'black' else (0.7,0.7,0.7,1)
                    size_hint_y: 0.2
