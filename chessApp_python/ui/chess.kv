#:kivy 1.0.9

<MenuScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 15

        Label:
            text: "Lichess Game Setup"
            font_size: '24sp'
            size_hint_y: 0.2

        TextInput:
            id: token_input
            hint_text: "Enter Lichess Token"
            multiline: False
            size_hint_y: 0.2

        TextInput:
            id: serial_input
            hint_text: "Enter Serial Port (e.g., COM3 or /dev/ttyUSB0)"
            multiline: False
            size_hint_y: 0.2

        Button:
            text: "Start Game"
            size_hint_y: 0.2
            background_color: 0.1, 0.6, 0.3, 1
            on_press:
                root.start_game()

<ChessGameScreen>:
    BoxLayout:
        orientation: 'horizontal'
        padding: 20
        spacing: 15

        # Opponent section (left)
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.48
            spacing: 8
            canvas.before:
                Color:
                    rgba: (0.75, 0.82, 1, 1) if root.active_player == 'opponent' else (0.93, 0.93, 0.93, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: root.opponent_name
                font_size: '22sp'
                bold: True
                color: (0.13, 0.22, 0.5, 1) if root.active_player == 'opponent' else (0.3, 0.3, 0.3, 1)
                size_hint_y: 0.2
            Label:
                id: opponent_time
                text: root.opponent_time
                font_size: '36sp'
                color: (0.8,0.1,0.1,1) if root.active_player == 'opponent' else (0.4,0.4,0.4,1)
                size_hint_y: 0.35
            Label:
                id: opponent_increment
                text: '+{}'.format(root.opponent_increment)
                font_size: '18sp'
                color: (0.4,0.4,0.7,1) if root.active_player == 'opponent' else (0.6,0.6,0.6,1)
                size_hint_y: 0.15
            Label:
                id: opponent_last_move
                text: 'Last move: {}'.format(root.opponent_last_move)
                font_size: '18sp'
                color: (0.13, 0.22, 0.5, 1) if root.active_player == 'opponent' else (0.5,0.5,0.5,1)
                size_hint_y: 0.2

        # Divider
        Widget:
            size_hint_x: 0.04

        # Player section (right)
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.48
            spacing: 8
            canvas.before:
                Color:
                    rgba: (0.78, 1, 0.78, 1) if root.active_player == 'player' else (0.93, 0.93, 0.93, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: root.player_name
                font_size: '22sp'
                bold: True
                color: (0.1, 0.5, 0.1, 1) if root.active_player == 'player' else (0.3, 0.3, 0.3, 1)
                size_hint_y: 0.2
            Label:
                id: player_time
                text: root.player_time
                font_size: '36sp'
                color: (0.1,0.5,0.1,1) if root.active_player == 'player' else (0.4,0.4,0.4,1)
                size_hint_y: 0.35
            Label:
                id: player_increment
                text: '+{}'.format(root.player_increment)
                font_size: '18sp'
                color: (0.2,0.5,0.2,1) if root.active_player == 'player' else (0.6,0.6,0.6,1)
                size_hint_y: 0.15
            Label:
                id: player_last_move
                text: 'Last move: {}'.format(root.player_last_move)
                font_size: '18sp'
                color: (0.1, 0.5, 0.1, 1) if root.active_player == 'player' else (0.5,0.5,0.5,1)
                size_hint_y: 0.2

