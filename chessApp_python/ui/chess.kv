#:kivy 1.0.9

<MenuScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 15

        Label:
            text: "Lichess Game Setup"
            font_size: '24sp'
            size_hint_y: 0.2

        Button:
            text: "Configure"
            size_hint_y: 0.2
            background_color: 0.1, 0.6, 0.3, 1
            on_press:
                root.configure()

        Button:
            text: "Attach to ongoing game"
            size_hint_y: 0.2
            background_color: 0.1, 0.6, 0.3, 1
            on_press:
                root.attach_game()

        Button:
            text: "15+10"
            size_hint_y: 0.2
            background_color: 0.1, 0.6, 0.3, 1
            on_press:
                root.start_game()

<ConfigScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 15

        Label:
            text: "Urichess configurations"
            font_size: '24sp'
            size_hint_y: 0.2

        TextInput:
            id: token_input
            hint_text: "Enter Lichess Token"
            multiline: False
            size_hint_y: 0.2

        TextInput:
            id: serial_input
            hint_text: "Enter Serial Port (e.g., COM3 or /dev/ttyUSB0)"
            multiline: False
            size_hint_y: 0.2

        Button:
            text: "Save"
            size_hint_y: 0.2
            background_color: 0.1, 0.6, 0.3, 1
            on_press:
                root.on_save()

        Button:
            text: "Cancel"
            size_hint_y: 0.2
            background_color: 0.1, 0.6, 0.3, 1
            on_press:
                root.on_cancel()

<WaitScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 15
        canvas.before:
            Color:
                rgba: 0, 0, 0, 0.8
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "Please wait..."
            font_size: '28sp'
            color: (1, 1, 1, 1)
            halign: 'center'
            valign: 'middle'
            text_size: self.size

        # Optional animated indicator
        Label:
            text: "⏳"
            font_size: '64sp'
            halign: 'center'
            valign: 'middle'
            text_size: self.size

<ChessGameScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 15

        # Top bar for game info
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: 0.1
            spacing: 10
            Label:
                text: "Game ID: {}".format(root.game_id if hasattr(root, 'game_id') else 'N/A')
                font_size: '18sp'
                color: (0.7, 0.7, 0.7, 1)
            Label:
                text: "Status: {}".format(root.game_status if hasattr(root, 'game_status') else 'In Progress')
                font_size: '18sp'
                color: (0.7, 0.7, 0.7, 1)
                halign: 'right'

        # Player sections
        BoxLayout:
            orientation: 'horizontal'
            spacing: 15



            # White player section
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.48
                spacing: 8
                padding: 10

                canvas.before:
                    Color:
                        rgba: (0.85, 0.85, 0.85, 1)
                    Rectangle:
                        pos: self.pos
                        size: self.size

                canvas.after:
                    Color:
                        rgba: (1, 0, 0, 0.8) if root.active_player == 'white' and root.last_move_red else (0, 1, 0, 0.8) if root.active_player == 'white' else (0, 0, 0, 0)
                    Line:
                        width: 4
                        rounded_rectangle: [self.x, self.y, self.width, self.height, 15, 15, 15, 15]

                Label:
                    text: "{} ({} Elo)".format(root.white_name, root.white_rating if hasattr(root, 'white_rating') else '?')
                    font_size: '22sp'
                    bold: True
                    color: (0.1, 0.1, 0.1, 1)
                    size_hint_y: 0.2

                Label:
                    id: white_time
                    text: root.white_time if hasattr(root, 'white_time') else '05:00'
                    font_size: '36sp'
                    color: (1,0,0,1) if root.white_time_seconds <= 30 else (0,0.5,0,1) if root.white_time_seconds < 604800 else (0.2,0.2,0.2,1)
                    size_hint_y: 0.35

            # Last move label in center
            Label:
                text: root.last_move if hasattr(root, 'last_move') else '-'
                font_size: '48sp'
                italic: True
                bold: True
                color: (0.9,0.4,0.4,1) if root.last_move_red else (0.9, 0.9, 0.9, 1)
                size_hint_x: 0.3
                halign: 'center'
                valign: 'middle'
                text_size: self.size

            # Black player section
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.48
                spacing: 8
                padding: 10

                canvas.before:
                    Color:
                        rgba: (0.35, 0.35, 0.35, 1)
                    Rectangle:
                        pos: self.pos
                        size: self.size

                canvas.after:
                    Color:
                        rgba: (1, 0, 0, 0.8) if root.active_player == 'black' and root.last_move_red  else (0, 1, 0, 0.8) if root.active_player == 'black' else (0, 0, 0, 0)
                    Line:
                        width: 4
                        rounded_rectangle: [self.x, self.y, self.width, self.height, 15, 15, 15, 15]

                Label:
                    text: "{} ({} Elo)".format(root.black_name, root.black_rating if hasattr(root, 'black_rating') else '?')
                    font_size: '22sp'
                    bold: True
                    color: (1, 1, 1, 1)
                    size_hint_y: 0.2

                Label:
                    id: black_time
                    text: root.black_time if hasattr(root, 'black_time') else '05:00'
                    font_size: '36sp'
                    color: (1,0,0,1) if root.black_time_seconds <= 30 else (0,0.5,0,1) if root.black_time_seconds < 604800 else (1,1,1,1)
                    size_hint_y: 0.35
