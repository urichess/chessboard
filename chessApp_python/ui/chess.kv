#:kivy 1.0.9

<MenuScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 15

        Label:
            text: "Lichess Game Setup"
            font_size: '24sp'
            size_hint_y: 0.2

        TextInput:
            id: token_input
            hint_text: "Enter Lichess Token"
            multiline: False
            size_hint_y: 0.2

        TextInput:
            id: serial_input
            hint_text: "Enter Serial Port (e.g., COM3 or /dev/ttyUSB0)"
            multiline: False
            size_hint_y: 0.2

        Button:
            text: "Start Game"
            size_hint_y: 0.2
            background_color: 0.1, 0.6, 0.3, 1
            on_press:
                root.start_game()

<ChessGameScreen>:
    BoxLayout:
        orientation: 'horizontal'
        padding: 20
        spacing: 15

        # White section (left)
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.48
            spacing: 8
            canvas.before:
                Color:
                    rgba: (1, 1, 1, 1) if root.active_player == 'white' else (0.93, 0.93, 0.93, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: 'White: {}'.format(root.white_name)
                font_size: '22sp'
                bold: True
                color: (0.1, 0.1, 0.1, 1) if root.active_player == 'white' else (0.5, 0.5, 0.5, 1)
                size_hint_y: 0.2
            Label:
                id: white_time
                text: root.white_time if hasattr(root, 'white_time') else '05:00'
                font_size: '36sp'
                color: (0.1,0.1,0.1,1) if root.active_player == 'white' else (0.4,0.4,0.4,1)
                size_hint_y: 0.35
            Label:
                id: white_last_move
                text: 'Moved: {}'.format(root.white_last_move) if hasattr(root, 'white_last_move') else 'Last move: -'
                font_size: '42sp'
                color: (0.1, 0.1, 0.1, 1) if root.active_player == 'white' else (0.5,0.5,0.5,1)
                size_hint_y: 0.2

        # Divider
        Widget:
            size_hint_x: 0.04

        # Black section (right)
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.48
            spacing: 8
            canvas.before:
                Color:
                    rgba: (0.15, 0.15, 0.15, 1) if root.active_player == 'black' else (0.3, 0.3, 0.3, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: 'Black: {}'.format(root.black_name)
                font_size: '22sp'
                bold: True
                color: (1, 1, 1, 1) if root.active_player == 'black' else (0.7, 0.7, 0.7, 1)
                size_hint_y: 0.2
            Label:
                id: black_time
                text: root.black_time if hasattr(root, 'black_time') else '05:00'
                font_size: '36sp'
                color: (1,1,1,1) if root.active_player == 'black' else (0.7,0.7,0.7,1)
                size_hint_y: 0.35
            Label:
                id: black_last_move
                text: 'Moved: {}'.format(root.black_last_move) if hasattr(root, 'black_last_move') else 'Last move: -'
                font_size: '42sp'
                color: (1, 1, 1, 1) if root.active_player == 'black' else (0.7,0.7,0.7,1)
                size_hint_y: 0.2

