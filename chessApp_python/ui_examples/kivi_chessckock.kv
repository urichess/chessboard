<ChessClock>:
    orientation: "vertical"
    padding: 20
    spacing: 15

    BoxLayout:
        size_hint_y: 0.6
        spacing: 10

        # Black clock
        BoxLayout:
            orientation: "vertical"
            canvas.before:
                Color:
                    rgba: (0.2, 0.2, 0.2, 1) if root.white_turn else (0.9, 0.7, 0.1, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: "BLACK"
                color: (1, 1, 1, 1)
                font_size: 22
            Label:
                text: root.format_time(root.black_time)
                color: (1, 1, 1, 1)
                font_size: 64

        # White clock
        BoxLayout:
            orientation: "vertical"
            canvas.before:
                Color:
                    rgba: (0.9, 0.9, 0.9, 1) if root.white_turn else (0.3, 0.3, 0.3, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: "WHITE"
                color: (0, 0, 0, 1)
                font_size: 22
            Label:
                text: root.format_time(root.white_time)
                color: (0, 0, 0, 1)
                font_size: 64

    BoxLayout:
        orientation: "vertical"
        size_hint_y: 0.4
        spacing: 10

        Label:
            text: "Last move: " + root.last_move
            font_size: 20

        BoxLayout:
            spacing: 10
            Button:
                text: "Start / Pause"
                font_size: 22
                on_release: root.toggle_clock()
            Button:
                text: "Switch Turn"
                font_size: 22
                on_release: root.switch_turn()
            Button:
                text: "Reset"
                font_size: 22
                on_release: root.reset_clock()

